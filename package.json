{
  "name": "you-skill",
  "private": true,
  "version": "0.10.0",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "build:cli": "node scripts/build-cli.mjs",
    "preview": "vite preview",
    "check": "npm run check:frontend && npm run check:backend",
    "check:frontend": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:backend": "cargo fmt --manifest-path src-tauri/Cargo.toml --all --check && cargo clippy --manifest-path src-tauri/Cargo.toml --workspace --all-targets -- -D warnings",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "test:frontend": "node --test tests/*.test.mjs",
    "test": "cargo test --manifest-path src-tauri/Cargo.toml --workspace",
    "release": "bash ./scripts/release.sh",
    "tauri": "tauri",
    "format": "npm run format:frontend && npm run format:backend",
    "format:frontend": "prettier --write \"**/*.{svelte,js,ts,css,scss,json}\"",
    "format:backend": "cargo fmt --manifest-path src-tauri/Cargo.toml --all",
    "format:check": "prettier --check \"**/*.{svelte,js,ts,css,scss,json}\""
  },
  "dependencies": {
    "@iconify/svelte": "^5.2.3",
    "@lobehub/icons-static-svg": "1.94.0",
    "@lucide/svelte": "^0.563.1",
    "@sveltejs/kit": "^2.50.2",
    "@tauri-apps/api": "^2.11.0",
    "@tauri-apps/plugin-dialog": "^2.7.1",
    "@tauri-apps/plugin-fs": "^2.5.1",
    "@tauri-apps/plugin-opener": "^2.5.3",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-shell": "^2.2.0",
    "@tauri-apps/plugin-updater": "^2.10.0",
    "bits-ui": "^2.19.5",
    "gray-matter": "^4.0.3",
    "highlight.js": "^11.11.1",
    "marked": "^17.0.6",
    "marked-cjk-friendly": "^0.1.2",
    "marked-highlight": "^2.2.3",
    "vite-plugin-node-polyfills": "^0.25.0"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/vite-plugin-svelte": "^5.0.0",
    "@tailwindcss/vite": "^4.0.0",
    "@tauri-apps/cli": "^2.1.0",
    "husky": "^9.0.0",
    "prettier": "^3.4.1",
    "prettier-plugin-svelte": "^3.5.0",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "svelte": "^5.0.0",
    "svelte-check": "^4.0.0",
    "tailwindcss": "^4.0.0",
    "vite": "^6.0.3"
  }
}
